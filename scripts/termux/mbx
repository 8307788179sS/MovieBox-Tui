#!/data/data/com.termux/files/usr/bin/sh
# mbx - keep the MovieBox Stremio addon and its HTTPS tunnel running.
#
#   mbx start     start addon + tunnel in the background (restarts any old copy)
#   mbx stop      stop both
#   mbx restart   stop, then start (the tunnel link changes)
#   mbx status    show what is running and the current link
#   mbx link      print the current Stremio addon link
#   mbx update    install the newest addon build, keeping the same link
#
# The addon listens on http://127.0.0.1:7000. A Cloudflare quick tunnel gives
# it an https://....trycloudflare.com address, which Stremio needs. That address
# changes whenever the tunnel restarts, so the current one is always written to
#   /sdcard/Download/moviebox-stremio-link.txt   and   ~/.mbx/link
#
# Installed by install-stremio-addon.sh. Logs are in ~/.mbx/.

PORT=7000
DIR="$HOME/.mbx"
LINK_FILE=/sdcard/Download/moviebox-stremio-link.txt
SELF="$PREFIX/bin/mbx"
mkdir -p "$DIR"

log() { echo "$(date '+%F %T') $*" >>"$DIR/mbx.log"; }

publish() {
	echo "$1" >"$DIR/link"
	echo "$1" >"$LINK_FILE" 2>/dev/null
}

# Keep logs from growing forever.
trim() { [ -f "$1" ] && [ "$(wc -c <"$1")" -gt 2000000 ] && tail -n 2000 "$1" >"$1.tmp" && mv "$1.tmp" "$1"; }

addon_loop() {
	while :; do
		trim "$DIR/addon.log"
		log "addon: starting"
		moviebox-stremio >>"$DIR/addon.log" 2>&1
		log "addon: exited ($?), restarting in 3s"
		sleep 3
	done
}

tunnel_loop() {
	while :; do
		# Wait until the addon answers before opening the tunnel.
		until curl -fsS -m 5 "http://127.0.0.1:$PORT/manifest.json" >/dev/null 2>&1; do sleep 2; done

		publish "starting... (link not ready yet)"
		log "tunnel: starting"
		cloudflared tunnel --no-autoupdate --url "http://127.0.0.1:$PORT" >"$DIR/tunnel.log" 2>&1 &
		pid=$!

		url=""
		i=0
		while [ -z "$url" ] && [ $i -lt 60 ] && kill -0 $pid 2>/dev/null; do
			sleep 2
			i=$((i + 1))
			url=$(grep -aoE 'https://[a-z0-9-]+\.trycloudflare\.com' "$DIR/tunnel.log" | head -n 1)
		done

		if [ -n "$url" ]; then
			publish "$url/manifest.json"
			log "tunnel: up at $url"
			# Health check once a minute; replace the tunnel after 3 failures in a row.
			fails=0
			sleep 20
			while kill -0 $pid 2>/dev/null; do
				if curl -fsS -m 20 "$url/manifest.json" >/dev/null 2>&1; then
					fails=0
				else
					fails=$((fails + 1))
					log "tunnel: health check failed ($fails/3)"
					[ $fails -ge 3 ] && kill $pid 2>/dev/null && break
				fi
				sleep 60
			done
		else
			log "tunnel: no link after 2 minutes"
			kill $pid 2>/dev/null
		fi

		wait $pid 2>/dev/null
		log "tunnel: stopped, restarting in 5s"
		sleep 5
	done
}

stop_all() {
	pkill -f "mbx _addon" 2>/dev/null
	pkill -f "mbx _tunnel" 2>/dev/null
	pkill -x moviebox-stremio 2>/dev/null
	pkill -x cloudflared 2>/dev/null
	sleep 1
}

case "$1" in
	_addon) addon_loop ;;
	_tunnel) tunnel_loop ;;
	start)
		stop_all
		termux-wake-lock 2>/dev/null
		nohup sh "$SELF" _addon >/dev/null 2>&1 &
		nohup sh "$SELF" _tunnel >/dev/null 2>&1 &
		echo "Starting. Run 'mbx link' in ~20 seconds for the Stremio link."
		;;
	stop)
		stop_all
		publish "stopped"
		echo "Stopped."
		;;
	restart) "$SELF" stop >/dev/null; "$SELF" start ;;
	status)
		pgrep -x moviebox-stremio >/dev/null && echo "addon:  running" || echo "addon:  NOT running"
		pgrep -x cloudflared >/dev/null && echo "tunnel: running" || echo "tunnel: NOT running"
		echo "link:   $(cat "$DIR/link" 2>/dev/null)"
		;;
	link) cat "$DIR/link" 2>/dev/null ;;
	update)
		repo=$(cat "$DIR/repo" 2>/dev/null)
		if [ -z "$repo" ]; then
			echo "Don't know which GitHub repo to update from. Run the installer again with MBX_REPO set." >&2
			exit 1
		fi
		curl -fsSL "https://raw.githubusercontent.com/$repo/main/install-stremio-addon.sh" | MBX_REPO="$repo" bash || exit 1
		# Restart only the addon; the running loop starts the new binary and the
		# tunnel (and so the Stremio link) stays the same.
		pkill -x moviebox-stremio 2>/dev/null
		echo "Updated. The Stremio link has not changed."
		;;
	*) sed -n '2,10p' "$SELF" | sed 's/^# \{0,1\}//' ;;
esac
